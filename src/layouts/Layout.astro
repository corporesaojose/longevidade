---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "2º Workshop de Saúde Corpore | Seu Futuro Começa Agora — 15/11/2026",
  description = "Força, memória e autonomia depois dos 40. Encontro presencial com a Dra. Paloma Ratto, médica geriatra. 15 de novembro, domingo, 9h30 às 12h. 40 vagas. Corpore, São José dos Campos.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/logo-amarelo-icone.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Corpore" />

    <!-- Meta Pixel Base Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1841018156120390');
      // PageView disparado manualmente com event_id (deduplicacao CAPI)
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1841018156120390&ev=PageView&noscript=1" /></noscript>

    <!-- Schema.org -->
    <!-- Investimento ainda a definir: quando tiver valor, adicionar o bloco "offers" aqui. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "2º Workshop de Saúde Corpore — Seu Futuro Começa Agora",
      "description": "Força, memória e autonomia depois dos 40. Encontro sobre longevidade, prevenção e construção de saúde com a Dra. Paloma Ratto, médica geriatra.",
      "startDate": "2026-11-15T09:30:00-03:00",
      "endDate": "2026-11-15T12:00:00-03:00",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "maximumAttendeeCapacity": 40,
      "location": {
        "@type": "Place",
        "name": "Corpore",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Barão do Rio Branco, 540",
          "addressLocality": "São José dos Campos",
          "addressRegion": "SP",
          "addressCountry": "BR"
        }
      },
      "performer": {
        "@type": "Person",
        "name": "Dra. Paloma Ratto",
        "jobTitle": "Médica geriatra"
      },
      "organizer": {
        "@type": "Organization",
        "name": "Corpore",
        "url": "https://corporetraininggym.com.br"
      }
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

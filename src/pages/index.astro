---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// ============================================================
// DADOS DO EVENTO — edite aqui
// ============================================================
const EVENTO = {
  nome: "2º Workshop de Saúde Corpore",
  tema: "Seu Futuro Começa Agora",
  subtitulo: "Força, memória e autonomia depois dos 40",
  dataLonga: "Domingo, 15 de novembro de 2026",
  dataCurta: "15 de novembro",
  horario: "9h30 às 12h",
  vagas: 40,
  investimento: "R$ 60",
  convidada: "Dra. Paloma Ratto",
  especialidade: "Médica geriatra",
  // Foto em public/ (WebP 4:5). A versão -480 é carregada em telas pequenas.
  // Sem a foto, o site mostra um cartão com as iniciais.
  fotoConvidada: "/foto-dra-paloma.webp",
  fotoConvidadaSrcset: "/foto-dra-paloma-480.webp 480w, /foto-dra-paloma.webp 704w",
};

const desejos = [
  { icon: "✈️", text: "Viajar" },
  { icon: "🚶", text: "Caminhar" },
  { icon: "🎾", text: "Praticar seu esporte favorito" },
  { icon: "👧", text: "Brincar com seus netos" },
  { icon: "☀️", text: "Ter disposição e independência para aproveitar a vida" },
];

const pilares = ["Sono", "Força muscular", "Memória", "Atividade física", "Hábitos do dia a dia"];

const passos = [
  {
    n: "01",
    titulo: "Entender o que ajuda a preservar sua autonomia",
    desc: "Conheça a importância da força, do movimento, do sono e dos hábitos cotidianos para a memória, a saúde e a independência ao longo dos anos.",
  },
  {
    n: "02",
    titulo: "Reconhecer o que precisa de mais atenção",
    desc: "Reflita sobre sua rotina e identifique quais aspectos da sua saúde merecem ser priorizados neste momento da vida.",
  },
  {
    n: "03",
    titulo: "Esclarecer dúvidas sobre envelhecimento e prevenção",
    desc: "Converse sobre longevidade, envelhecimento saudável e cuidados que podem contribuir para manter sua qualidade de vida.",
  },
  {
    n: "04",
    titulo: "Construir seu primeiro passo para os próximos 30 dias",
    desc: "Transforme o conhecimento adquirido em uma atitude prática, realista e possível de incorporar à sua rotina.",
  },
];

const detalhes = [
  { icon: "🎯", label: "Evento", value: "2º Workshop de Saúde Corpore — Seu Futuro Começa Agora" },
  { icon: "💬", label: "Tema", value: "Longevidade, força, memória e autonomia depois dos 40" },
  { icon: "🩺", label: "Convidada", value: "Dra. Paloma Ratto — Médica geriatra" },
  { icon: "📅", label: "Data", value: "Domingo, 15 de novembro de 2026" },
  { icon: "🕘", label: "Horário", value: "9h30 às 12h" },
  { icon: "📍", label: "Local", value: "Corpore · Av. Barão do Rio Branco, 540 — Jardim Esplanada — São José dos Campos/SP" },
  { icon: "🔒", label: "Vagas", value: "40 participantes" },
  { icon: "💰", label: "Investimento", value: "R$ 60 por pessoa" },
  { icon: "👥", label: "Público", value: "Pessoas interessadas em envelhecimento saudável, prevenção, longevidade e construção de saúde, independentemente de já praticarem atividade física" },
];

const faqs = [
  {
    q: "Preciso ser aluno da Corpore para participar?",
    a: "Não. O workshop é aberto para alunos, convidados e pessoas da comunidade interessadas em saúde e longevidade.",
  },
  {
    q: "Nunca pratiquei atividade física. O workshop também é para mim?",
    a: "Sim! O encontro é uma oportunidade para compreender melhor a importância dos hábitos de saúde e identificar por onde começar, respeitando sua realidade.",
  },
  {
    q: "Preciso ter mais de 60 anos?",
    a: "Não. O workshop foi pensado especialmente para adultos a partir dos 40 anos, mas o tema é importante para pessoas de diferentes idades.",
  },
  {
    q: "O que vou aprender?",
    a: "Você vai entender como força, sono e hábitos se relacionam com memória e autonomia, reconhecer prioridades na sua rotina, esclarecer dúvidas e definir um primeiro passo para os próximos 30 dias.",
  },
  {
    q: "O workshop inclui uma consulta médica individual?",
    a: "Não. Trata-se de um encontro educativo e presencial, com espaço para perguntas e reflexão. Ele não substitui uma avaliação médica individualizada.",
  },
  {
    q: "Como confirmo minha vaga?",
    a: "Preencha o formulário e siga as orientações recebidas pelo WhatsApp da Corpore.",
  },
  {
    q: "Qual o investimento?",
    a: "O investimento é de R$ 60 por pessoa. Depois de preencher o cadastro, você recebe pelo WhatsApp da Corpore as orientações de pagamento e a confirmação da vaga.",
  },
];

const inputStyle = "padding: 14px 16px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.07); color: #fff; font-size: 0.95rem; outline: none; font-family: inherit; width: 100%; box-sizing: border-box;";
const labelStyle = "font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-teal);";
const h2Light = "font-size: clamp(1.6rem, 3.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; color: var(--color-charcoal); margin-bottom: 20px;";
const h2Dark = "font-size: clamp(1.6rem, 3.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; color: #fff; margin-bottom: 20px;";
---

<Layout>
  <!-- ============================================================
       HEADER / NAV
  ============================================================ -->
  <header
    style="
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 0 24px;
      background: rgba(42, 42, 41, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    "
  >
    <div class="section-inner" style="display: flex; align-items: center; justify-content: space-between; height: 68px;">
      <a href="/" aria-label="Corpore">
        <img
          src="/logo-branco.png"
          alt="Corpore"
          style="height: 36px; width: auto;"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <span style="display: none; align-items: center; gap: 8px; font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.1rem; color: #fff;">
          <span style="color: var(--color-yellow);">●</span> CORPORE
        </span>
      </a>

      <nav style="display: flex; align-items: center; gap: 32px;" class="desktop-nav">
        {[["#workshop","O workshop"],["#convidada","Convidada"],["#detalhes","Detalhes"]].map(([href, label]) => (
          <a
            href={href}
            style="font-size: 0.88rem; font-weight: 600; color: rgba(255,255,255,0.72); transition: color 0.2s;"
            onmouseover="this.style.color='#fff'"
            onmouseout="this.style.color='rgba(255,255,255,0.72)'"
          >{label}</a>
        ))}
        <a href="#formulario" class="btn-primary animate-pulse-btn" style="padding: 10px 22px; font-size: 0.88rem;">
          Quero Participar!
        </a>
      </nav>

      <button
        id="menu-toggle"
        aria-label="Abrir menu"
        style="display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px;"
      >
        <span style="display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px;"></span>
        <span style="display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px;"></span>
        <span style="display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px;"></span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" style="padding: 0 24px;">
      <div style="padding: 16px 0; display: flex; flex-direction: column; gap: 16px; border-top: 1px solid rgba(255,255,255,0.08);">
        <a href="#workshop" style="font-weight: 600; color: rgba(255,255,255,0.8);">O workshop</a>
        <a href="#convidada" style="font-weight: 600; color: rgba(255,255,255,0.8);">Convidada</a>
        <a href="#detalhes" style="font-weight: 600; color: rgba(255,255,255,0.8);">Detalhes</a>
        <a href="#formulario" class="btn-primary" style="text-align: center;">Quero Participar!</a>
      </div>
    </div>
  </header>

  <main>

    <!-- ============================================================
         1. ABERTURA — HERO
    ============================================================ -->
    <section
      id="hero"
      aria-labelledby="hero-title"
      style="
        min-height: 100vh;
        padding: 120px 24px 80px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background:
          radial-gradient(circle at top right, rgba(0,180,200,0.18), transparent 55%),
          radial-gradient(circle at bottom left, rgba(70,121,154,0.22), transparent 50%),
          linear-gradient(160deg, #2a2a29 0%, #3e3e3d 70%, #444443 100%);
      "
    >
      <div class="section-inner">
        <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center;" class="hero-grid">
          <!-- LEFT -->
          <div>
            <p class="reveal section-label" style="color: var(--color-teal); margin-bottom: 18px;">
              {EVENTO.nome} · {EVENTO.tema}
            </p>
            <h1
              id="hero-title"
              class="reveal"
              style="font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(2rem, 4.4vw, 3.4rem); letter-spacing: -0.03em; color: #fff; margin-bottom: 24px; line-height: 1.12;"
            >
              Você quer chegar bem aos 80?
              <span style="color: var(--color-yellow); display: block;">Comece a cuidar disso hoje.</span>
            </h1>

            <div class="reveal" style="margin-bottom: 32px; display: flex; flex-direction: column; gap: 14px;">
              <p style="font-size: 1.02rem; color: rgba(255,255,255,0.78); line-height: 1.65;">
                Na correria do dia a dia, o exercício fica para depois, o sono perde espaço e cuidar da saúde acaba entrando na agenda só quando aparece um problema.
              </p>
              <p style="font-size: 1.02rem; color: rgba(255,255,255,0.78); line-height: 1.65;">
                Mas você já parou para pensar como essas escolhas podem influenciar sua vida daqui a 10, 20 ou 30 anos?
              </p>
              <p style="font-size: 1.05rem; font-weight: 600; color: rgba(255,255,255,0.92); line-height: 1.6;">
                No dia 15 de novembro, a Corpore recebe a <span style="color: var(--color-yellow);">Dra. Paloma Ratto, médica geriatra</span>, para um encontro sobre longevidade, prevenção e construção de saúde.
              </p>
              <p style="font-size: 1.02rem; color: rgba(255,255,255,0.78); line-height: 1.65;">
                Uma oportunidade para entender o que merece sua atenção hoje e como começar a mudar seus hábitos de um jeito possível para você.
              </p>
            </div>

            <div class="reveal" style="display: flex; flex-direction: column; align-items: flex-start; gap: 14px;">
              <a href="#formulario" class="btn-primary animate-pulse-btn">Quero participar do workshop</a>

              <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px;">
                <span class="pill-tag" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.8);">
                  <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-yellow); flex-shrink: 0;"></span>
                  15 de novembro · Domingo · 9h30–12h
                </span>
                <span class="pill-tag" style="background: rgba(0,180,200,0.12); border: 1px solid rgba(0,180,200,0.22); color: var(--color-teal);">
                  <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-teal); flex-shrink: 0;"></span>
                  40 vagas
                </span>
                <span class="pill-tag" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.8);">
                  R$ 60
                </span>
                <span class="pill-tag" style="background: rgba(226,222,30,0.15); border: 1px solid rgba(226,222,30,0.35); color: var(--color-yellow); font-weight: 700;">
                  📍 Evento presencial
                </span>
              </div>
              <p style="font-size: 0.85rem; color: rgba(255,255,255,0.5);">Corpore — São José dos Campos</p>
            </div>
          </div>

          <!-- RIGHT: convidada -->
          <div class="reveal" style="position: relative;">
            <div
              style="position: absolute; top: -14px; left: 16px; z-index: 2; padding: 6px 14px; border-radius: 999px; background: rgba(42,42,41,0.88); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.85); display: flex; align-items: center; gap: 6px;"
            >
              <span style="color: var(--color-teal);">✦</span>
              Convidada especial
            </div>

            <div style="border-radius: 20px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); position: relative; background: linear-gradient(160deg, rgba(70,121,154,0.35), rgba(0,180,200,0.12));">
              <img
                src={EVENTO.fotoConvidada}
                srcset={EVENTO.fotoConvidadaSrcset}
                sizes="(max-width: 899px) 92vw, 480px"
                width="704" height="880"
                fetchpriority="high"
                alt="Dra. Paloma Ratto, médica geriatra"
                style="width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: center top; display: block;"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <!-- Fallback enquanto a foto oficial não chega -->
              <div style="display: none; width: 100%; aspect-ratio: 4/5; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding-bottom: 96px; box-sizing: border-box;">
                <div style="width: 132px; height: 132px; border-radius: 50%; background: rgba(255,255,255,0.08); border: 2px solid rgba(226,222,30,0.55); display: flex; align-items: center; justify-content: center; font-family: 'Sora', sans-serif; font-weight: 800; font-size: 2.6rem; color: var(--color-yellow); letter-spacing: -0.02em;">PR</div>
                <p style="font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.05rem; color: rgba(255,255,255,0.85); text-align: center; padding: 0 24px;">Longevidade, prevenção<br />e construção de saúde</p>
              </div>

              <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 36px 22px 20px; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.45) 60%, transparent 100%);">
                <p style="font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.25rem; color: #fff; margin-bottom: 2px;">{EVENTO.convidada}</p>
                <p style="font-size: 0.9rem; font-weight: 600; color: var(--color-teal);">{EVENTO.especialidade}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ============================================================
         2. IDENTIFICAÇÃO — O FUTURO QUE VOCÊ DESEJA
    ============================================================ -->
    <section id="futuro" style="padding: 96px 24px; background: var(--color-offwhite);">
      <div class="section-inner">
        <div class="reveal" style="max-width: 680px; margin-bottom: 48px;">
          <p class="section-label" style="margin-bottom: 14px;">O futuro que você deseja</p>
          <h2 style={h2Light}>O que você quer continuar fazendo daqui a 20 anos?</h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-bottom: 48px;">
          {desejos.map((d, i) => (
            <div class="reveal problem-card" style={`transition-delay: ${i * 0.08}s; align-items: center;`}>
              <span style="font-size: 1.6rem; line-height: 1; flex-shrink: 0;">{d.icon}</span>
              <p style="font-size: 0.98rem; font-weight: 600; color: var(--color-charcoal); line-height: 1.45;">{d.text}</p>
            </div>
          ))}
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;" class="two-col-grid">
          <p class="reveal" style="font-size: 1.05rem; color: #555; line-height: 1.75;">
            Todos nós queremos viver mais. Mas, tão importante quanto a quantidade de anos, é a qualidade de vida que teremos ao longo deles. E existe algo fundamental que nem sempre percebemos:
          </p>
          <div class="reveal card-glass" style="padding: 28px 32px; border-left: 4px solid var(--color-yellow);">
            <p style="font-family: 'Sora', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--color-charcoal); line-height: 1.45; margin-bottom: 14px;">
              A saúde que você deseja para o futuro começa a ser construída no presente.
            </p>
            <p style="font-size: 0.95rem; color: #666; line-height: 1.7;">
              Não é preciso esperar chegar aos 60, 70 ou 80 anos para começar a pensar em longevidade. Muito menos esperar algum problema de saúde aparecer.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- ============================================================
         3. APRESENTAÇÃO DO WORKSHOP
    ============================================================ -->
    <section
      id="workshop"
      style="
        padding: 96px 24px;
        background:
          radial-gradient(circle at bottom right, rgba(70,121,154,0.25), transparent 55%),
          var(--gradient-dark);
        color: #fff;
      "
    >
      <div class="section-inner">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;" class="two-col-grid">
          <div>
            <p class="reveal section-label" style="color: var(--color-teal); margin-bottom: 14px;">O workshop</p>
            <h2 class="reveal" style={h2Dark}>Você sabe o que merece atenção na sua saúde hoje?</h2>
            <p class="reveal" style="font-size: 1.05rem; color: rgba(255,255,255,0.75); line-height: 1.75; margin-bottom: 20px;">
              Sono, força muscular, memória, atividade física e hábitos cotidianos são aspectos importantes da construção de saúde ao longo da vida. Mas, entre tantas informações e recomendações, por onde começar?
            </p>
            <p class="reveal" style="font-size: 1.05rem; font-weight: 700; color: #fff; line-height: 1.6; margin-bottom: 20px;">
              O Workshop Seu Futuro Começa Agora foi criado para ajudar você a responder essa pergunta.
            </p>
            <p class="reveal" style="font-size: 1.05rem; color: rgba(255,255,255,0.75); line-height: 1.75; margin-bottom: 36px;">
              Durante um encontro presencial com a geriatra Dra. Paloma Ratto, você vai compreender melhor suas prioridades de saúde, refletir sobre sua rotina e descobrir atitudes possíveis para começar a cuidar do seu futuro.
            </p>
            <a href="#formulario" class="reveal btn-primary">Quero participar</a>
          </div>

          <div class="reveal" style="display: flex; flex-direction: column; gap: 20px;">
            <div style="padding: 28px; border-radius: 20px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
              <p class="section-label" style="color: rgba(255,255,255,0.5); margin-bottom: 16px;">O que entra na conversa</p>
              <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                {pilares.map((p) => (
                  <span class="pill-tag" style="background: rgba(0,180,200,0.12); border: 1px solid rgba(0,180,200,0.25); color: #fff; font-size: 0.92rem; padding: 9px 16px;">{p}</span>
                ))}
              </div>
            </div>
            <div style="padding: 28px; border-radius: 20px; background: rgba(226,222,30,0.1); border: 1px solid rgba(226,222,30,0.3);">
              <p style="font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.15rem; color: var(--color-yellow); line-height: 1.45;">
                Mais do que receber informações, a proposta é sair com clareza sobre o que pode mudar no seu dia a dia.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ============================================================
         4. O QUE VOCÊ VAI APRENDER
    ============================================================ -->
    <section id="aprender" style="padding: 96px 24px; background: var(--color-offwhite);">
      <div class="section-inner">
        <div class="reveal" style="text-align: center; max-width: 640px; margin: 0 auto 56px;">
          <p class="section-label" style="margin-bottom: 14px;">O que você vai aprender</p>
          <h2 style={h2Light}>Quatro passos para começar a construir sua saúde.</h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; margin-bottom: 48px;">
          {passos.map((p, i) => (
            <div class="reveal specialist-card" style={`transition-delay: ${i * 0.08}s;`}>
              <p class="step-number">{p.n}</p>
              <p style="font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.05rem; color: var(--color-charcoal); line-height: 1.35; margin-bottom: 10px;">{p.titulo}</p>
              <p style="font-size: 0.92rem; color: #555; line-height: 1.6;">{p.desc}</p>
            </div>
          ))}
        </div>

        <p class="reveal" style="text-align: center; font-family: 'Sora', sans-serif; font-weight: 700; font-size: clamp(1.1rem, 2.2vw, 1.35rem); color: var(--color-charcoal); max-width: 720px; margin: 0 auto; line-height: 1.45;">
          Porque cuidar do seu futuro não precisa começar com grandes mudanças. <span style="background: var(--color-yellow); padding: 0 6px; border-radius: 4px;">Precisa começar.</span>
        </p>
      </div>
    </section>


    <!-- ============================================================
         5. QUEBRANDO A BARREIRA DE QUEM AINDA NÃO COMEÇOU
    ============================================================ -->
    <section id="comecar" style="padding: 96px 24px; background: var(--color-white);">
      <div class="section-inner" style="max-width: 760px;">
        <p class="reveal section-label" style="margin-bottom: 14px;">Para quem ainda não começou</p>
        <h2 class="reveal" style={h2Light}>Faz tempo que você sabe que precisa cuidar mais da sua saúde?</h2>
        <p class="reveal" style="font-size: 1.05rem; color: #555; line-height: 1.75; margin-bottom: 16px;">
          Talvez você já tenha pensado em começar a se exercitar, melhorar o sono ou mudar alguns hábitos. Mas a rotina é corrida, surgem outras prioridades e você acaba deixando para depois.
        </p>
        <p class="reveal" style="font-size: 1.05rem; color: #555; line-height: 1.75; margin-bottom: 32px;">
          Talvez nem saiba exatamente por onde começar.
        </p>

        <div class="reveal card-glass" style="padding: 28px 32px; border-left: 4px solid var(--color-yellow); margin-bottom: 32px;">
          <p style="font-family: 'Sora', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--color-charcoal); line-height: 1.4; margin-bottom: 12px;">
            A boa notícia é que você não precisa mudar tudo de uma vez.
          </p>

    'Vila São Pedro',
    'Vila Tatetuba',
    'Vila Tesouro',
    'Vista Verde',
    'Não moro em São José dos Campos',
  ];

  function semAcento(texto: string): string {
    return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  }

  const BAIRROS_INDEX = BAIRROS_SJC.map((nome) => ({ nome, norm: semAcento(nome) }));

  const inputBairro = document.getElementById('f-bairro') as HTMLInputElement | null;
  const listaBairro = document.getElementById('bairro-opcoes') as HTMLUListElement | null;
  let bairrosFiltrados: { nome: string; norm: string }[] = [];
  let bairroAtivo = -1;

  function fecharBairros(): void {
    if (!inputBairro || !listaBairro) return;
    listaBairro.hidden = true;
    listaBairro.innerHTML = '';
    bairrosFiltrados = [];
    bairroAtivo = -1;
    inputBairro.setAttribute('aria-expanded', 'false');
    inputBairro.removeAttribute('aria-activedescendant');
  }

  function marcarAtivo(indice: number): void {
    if (!inputBairro || !listaBairro) return;
    const itens = listaBairro.querySelectorAll('li[role="option"]');
    itens.forEach((el, i) => {
      el.setAttribute('aria-selected', i === indice ? 'true' : 'false');
    });
    bairroAtivo = indice;
    const alvo = itens[indice] as HTMLElement | undefined;
    if (alvo) {
      alvo.scrollIntoView({ block: 'nearest' });
      inputBairro.setAttribute('aria-activedescendant', alvo.id);
    } else {
      inputBairro.removeAttribute('aria-activedescendant');
    }
  }

  function escolherBairro(indice: number): void {
    const escolhido = bairrosFiltrados[indice];
    if (!escolhido || !inputBairro) return;
    inputBairro.value = escolhido.nome;
    inputBairro.setCustomValidity('');
    fecharBairros();
  }

  function abrirBairros(termo: string): void {
    if (!inputBairro || !listaBairro) return;
    const busca = semAcento(termo);
    if (busca.length < 2) { fecharBairros(); return; }

    const comecaCom: { nome: string; norm: string }[] = [];
    const contem: { nome: string; norm: string }[] = [];
    for (const item of BAIRROS_INDEX) {
      const pos = item.norm.indexOf(busca);
      if (pos === 0) comecaCom.push(item);
      else if (pos > 0) contem.push(item);
    }
    bairrosFiltrados = comecaCom.concat(contem).slice(0, 8);

    listaBairro.innerHTML = '';
    if (bairrosFiltrados.length === 0) {
      const vazio = document.createElement('li');
      vazio.className = 'bairro-vazio';
      vazio.textContent = 'Bairro não encontrado. Pode seguir com o que você digitou.';
      listaBairro.appendChild(vazio);
    } else {
      bairrosFiltrados.forEach((item, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.id = 'bairro-op-' + i;
        const pos = item.norm.indexOf(busca);
        const destaque = document.createElement('mark');
        destaque.textContent = item.nome.slice(pos, pos + busca.length);
        li.append(
          document.createTextNode(item.nome.slice(0, pos)),
          destaque,
          document.createTextNode(item.nome.slice(pos + busca.length)),
        );
        li.addEventListener('pointerdown', (ev) => {
          ev.preventDefault();
          escolherBairro(i);
        });
        listaBairro.appendChild(li);
      });
    }
    listaBairro.hidden = false;
    inputBairro.setAttribute('aria-expanded', 'true');
    bairroAtivo = -1;
  }

  inputBairro?.addEventListener('input', () => abrirBairros(inputBairro.value));
  inputBairro?.addEventListener('focus', () => abrirBairros(inputBairro.value));

  inputBairro?.addEventListener('keydown', (ev: KeyboardEvent) => {
    const aberto = listaBairro && !listaBairro.hidden && bairrosFiltrados.length > 0;
    if (ev.key === 'ArrowDown' && aberto) {
      ev.preventDefault();
      marcarAtivo((bairroAtivo + 1) % bairrosFiltrados.length);
    } else if (ev.key === 'ArrowUp' && aberto) {
      ev.preventDefault();
      marcarAtivo(bairroAtivo <= 0 ? bairrosFiltrados.length - 1 : bairroAtivo - 1);
    } else if (ev.key === 'Enter' && aberto && bairroAtivo >= 0) {
      ev.preventDefault();
      escolherBairro(bairroAtivo);
    } else if (ev.key === 'Escape') {
      fecharBairros();
    }
  });

  // Ao sair do campo: fecha a lista e corrige acento/caixa se bateu com a lista
  inputBairro?.addEventListener('blur', () => {
    window.setTimeout(() => {
      if (inputBairro) {
        const busca = semAcento(inputBairro.value);
        const exato = BAIRROS_INDEX.find((item) => item.norm === busca);
        if (exato) inputBairro.value = exato.nome;
      }
      fecharBairros();
    }, 120);
  });

  // ============================================================
  // MASCARA DO WHATSAPP — (12) 99999-9999
  // ============================================================
  const inputWhats = document.getElementById('f-whatsapp') as HTMLInputElement | null;
  inputWhats?.addEventListener('input', () => {
    const d = inputWhats.value.replace(/\D/g, '').slice(0, 11);
    let saida = d;
    if (d.length > 6) {
      const corte = d.length > 10 ? 7 : 6;
      saida = '(' + d.slice(0, 2) + ') ' + d.slice(2, corte) + '-' + d.slice(corte);
    } else if (d.length > 2) {
      saida = '(' + d.slice(0, 2) + ') ' + d.slice(2);
    }
    inputWhats.value = saida;
    inputWhats.setCustomValidity('');
  });
  const form = document.getElementById('form-inscricao');
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btnSubmit) { btnSubmit.disabled = true; btnSubmit.textContent = 'Enviando...'; }

    const nome = (document.getElementById('f-nome') as HTMLInputElement).value.trim();
    const email = (document.getElementById('f-email') as HTMLInputElement).value.trim();
    const whatsapp = (document.getElementById('f-whatsapp') as HTMLInputElement).value.trim();
    const bairro = (document.getElementById('f-bairro') as HTMLInputElement).value.trim();

    // Meta CAPI espera o telefone com codigo do pais (E.164 sem "+")
    const phoneDigits = whatsapp.replace(/\D/g, '');
    const phoneCleaned = phoneDigits.startsWith('55') ? phoneDigits : '55' + phoneDigits;

    if (phoneDigits.length < 10) {
      const campoTel = document.getElementById('f-whatsapp') as HTMLInputElement;
      campoTel.setCustomValidity('Informe o WhatsApp com DDD.');
      campoTel.reportValidity();
      campoTel.addEventListener('input', () => campoTel.setCustomValidity(''), { once: true });
      if (btnSubmit) { btnSubmit.disabled = false; btnSubmit.textContent = 'Quero me inscrever no workshop'; }
      return;
    }

    const eventId = crypto.randomUUID();
    const fbp = getCookie('_fbp');
    const fbc = getCookie('_fbc');

    // Browser Pixel — Lead
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', 'Lead', {}, { eventID: eventId });
    }

    // CAPI — os nomes dos campos precisam bater com o que o workflow n8n le:
    // body.nome / body.email / body.telefone. Enviar com outro nome zera o match quality.
    const payload: Record<string, unknown> = {
      event_name: 'Lead',
      event_id: eventId,
      event_time: Math.floor(Date.now() / 1000),
      page_url: window.location.href,
      client_user_agent: navigator.userAgent,
      external_id: getExternalId(),
      nome,
      email,
      telefone: phoneCleaned,
      bairro,
      origem: ORIGEM_EVENTO,
    };
    if (fbp) payload.fbp = fbp;
    if (fbc) payload.fbc = fbc;

    mirrorCAPI(payload);

    // Planilha de inscricoes — este e o registro que o time usa. Dispara antes do redirect.
    const gravacao = gravarNaPlanilha({
      nome,
      email,
      telefone: phoneCleaned,
      bairro,
      origem: ORIGEM_EVENTO,
    });

    // Contact: a pessoa esta sendo levada ao WhatsApp para receber as informacoes e confirmar a vaga
    firePixelEvent('Contact');

    // So manda pro WhatsApp depois que a planilha respondeu (ou 3s, o que vier antes).
    await Promise.race([
      gravacao,
      new Promise((resolve) => setTimeout(resolve, 3000)),
    ]);

    window.location.href = linkWhatsappInscricao(nome);
  });
</script>

    left: 0;
    right: 0;
    z-index: 40;
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 240px;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background: #2c2c2b;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .bairro-opcoes[hidden] { display: none; }

  .bairro-opcoes li {
    padding: 11px 14px;
    border-radius: 8px;
    font-size: 0.92rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
  }

  .bairro-opcoes li[aria-selected='true'],
  .bairro-opcoes li:hover {
    background: rgba(0, 180, 200, 0.18);
    color: #fff;
  }

  .bairro-opcoes li.bairro-vazio { cursor: default; color: rgba(255, 255, 255, 0.45); font-size: 0.85rem; }
  .bairro-opcoes li.bairro-vazio:hover { background: transparent; }

  .bairro-opcoes li mark { background: transparent; color: var(--color-teal); font-weight: 700; }
</style>

<script>
  // Scroll Reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

  // FAQ Accordion
  document.querySelectorAll('.accordion-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const content = document.getElementById(targetId);
      const isOpen = content?.classList.contains('open');

      // Close all
      document.querySelectorAll('.accordion-content').forEach((c) => c.classList.remove('open'));
      document.querySelectorAll('.accordion-btn').forEach((b) => b.classList.remove('open'));

      // Open clicked
      if (!isOpen && content) {
        content.classList.add('open');
        btn.classList.add('open');
      }
    });
  });

  // Mobile menu
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('open');
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => mobileMenu.classList.remove('open'));
  });

  // Header: responsive nav visibility
  const desktopNav = document.querySelector('.desktop-nav') as HTMLElement | null;
  const menuBtn = document.getElementById('menu-toggle') as HTMLElement | null;

  function setNav() {
    if (window.innerWidth < 768) {
      if (desktopNav) desktopNav.style.display = 'none';
      if (menuBtn) menuBtn.style.display = 'flex';
    } else {
      if (desktopNav) desktopNav.style.display = 'flex';
      if (menuBtn) menuBtn.style.display = 'none';
      mobileMenu?.classList.remove('open');
    }
  }

  setNav();
  window.addEventListener('resize', setNav);

  // Two-col grid responsive (seções internas + hero)
  function setGrids() {
    document.querySelectorAll('.two-col-grid').forEach((g) => {
      const el = g as HTMLElement;
      if (window.innerWidth < 900) {
        el.style.gridTemplateColumns = '1fr';
        el.style.gap = '40px';
      } else {
        el.style.gridTemplateColumns = '1fr 1fr';
        el.style.gap = '64px';
      }
    });

    // Hero grid: empilha foto abaixo do texto em mobile
    const heroGrid = document.querySelector('.hero-grid') as HTMLElement | null;
    const heroBadges = document.querySelector('.hero-badges') as HTMLElement | null;
    if (heroGrid) {
      if (window.innerWidth < 900) {
        heroGrid.style.gridTemplateColumns = '1fr';
        heroGrid.style.gap = '40px';
      } else {
        heroGrid.style.gridTemplateColumns = '1fr 1fr';
        heroGrid.style.gap = '56px';
      }
    }
    // Badges de especialidade: visíveis só em mobile (no desktop a foto já cobre)
    if (heroBadges) {
      heroBadges.style.display = window.innerWidth < 900 ? 'flex' : 'none';
    }
  }

  setGrids();
  window.addEventListener('resize', setGrids);

  // ============================================================
  // META PIXEL + CAPI (Conversions API via n8n)
  // Cada evento gera um event_id unico, usado nos dois lados
  // para o Meta deduplicar browser + servidor.
  // ============================================================
  const N8N_WEBHOOK = 'https://n8n.corporetraininggym.com.br/webhook/health-map-lead';
  // Abre a conversa JA com uma mensagem pronta de quem se inscreveu: a pessoa so
  // toca em enviar e a equipe recebe o contato no WhatsApp da Corpore.
  // Nao usar links /link/... de anuncio aqui — eles carregam o texto
  // "Vi no Instagram...", que e do anuncio, nao de quem ja se inscreveu.
  const LINK_WHATSAPP = 'https://wa.me/551239094444';

  function linkWhatsappInscricao(nome: string): string {
    const primeiroNome = nome.split(/\s+/)[0] || nome;
    const texto =
      'Olá! Meu nome é ' + primeiroNome + ' e acabei de me inscrever pelo site no ' +
      '2º Workshop de Saúde Corpore (15/11, 9h30). ' +
      'Gostaria de receber as informações para confirmar minha vaga.';
    return LINK_WHATSAPP + '?text=' + encodeURIComponent(texto);
  }

  // Identificacao do evento: vai no campo "origem" da planilha e do CAPI.
  const ORIGEM_EVENTO = 'workshop-saude-40';

  // Grava a inscricao na planilha do 2º Workshop de Saude.
  // ATENCAO: o webhook antigo (workshop-sono-inscricao) grava na planilha do Workshop de Sono
  // e dispara no WhatsApp o dialogo de boas-vindas do SONO. Este endereco novo precisa de um
  // workflow no n8n (copia do "Workshop Sono → Planilha + ChatGuru" com planilha e dialog_id novos).
  const N8N_WEBHOOK_PLANILHA = 'https://n8n.corporetraininggym.com.br/webhook/workshop-saude-inscricao';

  // external_id estavel por navegador — o n8n faz o SHA-256 antes de mandar ao Meta.
  function getExternalId(): string {
    try {
      let id = localStorage.getItem('_meta_eid');
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem('_meta_eid', id);
      }
      return id;
    } catch {
      return crypto.randomUUID();
    }
  }

  function getCookie(name: string): string | null {
    const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }

  // keepalive: a requisicao precisa sobreviver ao redirect para o WhatsApp.
  function mirrorCAPI(payload: Record<string, unknown>): void {
    fetch(N8N_WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      keepalive: true,
    }).catch(() => {});
  }

  function gravarNaPlanilha(dados: Record<string, unknown>): Promise<unknown> {
    return fetch(N8N_WEBHOOK_PLANILHA, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(dados),
      keepalive: true,
    }).catch(() => {});
  }

  function firePixelEvent(eventName: string): void {
    const eventId = crypto.randomUUID();
    const fbp = getCookie('_fbp');
    const fbc = getCookie('_fbc');

    // Browser Pixel
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', eventName, {}, { eventID: eventId });
    }

    // Espelho CAPI (fire-and-forget)
    const payload: Record<string, unknown> = {
      event_name: eventName,
      event_id: eventId,
      event_time: Math.floor(Date.now() / 1000),
      page_url: window.location.href,
      client_user_agent: navigator.userAgent,
      external_id: getExternalId(),
    };
    if (fbp) payload.fbp = fbp;
    if (fbc) payload.fbc = fbc;

    mirrorCAPI(payload);
  }

  // PageView + ViewContent: delay 2.5s para aguardar o cookie _fbp do fbevents.js
  setTimeout(() => {
    firePixelEvent('PageView');
    firePixelEvent('ViewContent');
  }, 2500);

  // Lead: submit do formulario.
  // As PII vao em texto puro para o n8n, que faz o SHA-256 antes de enviar ao Meta CAPI.
  // Hashear aqui geraria hash duplo (o workflow rehasheia) e zeraria o match quality.

  // ============================================================
  // AUTOCOMPLETE DE BAIRROS — Sao Jose dos Campos
  // A pessoa digita sem acento/caixa e a lista devolve o nome correto.
  // ============================================================
  const BAIRROS_SJC: string[] = [
    'Aeroporto',
    'Alto da Ponte',
